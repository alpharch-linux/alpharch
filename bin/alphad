#!/usr/bin/env python3
"""
alphad — the Alpharch flow engine, v2

Every order-flow situation, one engine, switchable views. Live from free
public exchange websockets: no API keys, no accounts, no subscriptions.

  VIEWS (press the key live, or start with --view)
    f  flow      footprint — volume at price per time bucket, delta, imbalances
    d  dom       depth ladder — resting liquidity, walls, session profile
    h  heat      liquidity heatmap — the book through time (Bookmap, in a tty)
    t  tape      time & sales — prints, speed, big-print flags, CVD
    p  profile   session volume profile — POC, value area, delta per level
    l  liqs      liquidations + funding + open interest (perp feeds)

  FEEDS
    --exchange hyperliquid             perp trades + book + hourly funding + OI
                                       (US-reachable, keyless — the perp default)
    --exchange coinbase                spot trades + level2 book (if public)
    --exchange binance                 spot trades + top-20 book
    --exchange binance --market perp   perp trades + book + liqs + funding + OI
                                       (geo-blocked from US IPs)

  ANALYZE (deterministic facts a human or the Desk Brain can read)
    alphad --analyze ~/tapes/cpi-day.jsonl         # computed JSON, no AI

  REPLAY (drill your reads on recorded tape)
    alphad --record ~/tapes/nfp-day.jsonl          # record while watching
    alphad --replay ~/tapes/nfp-day.jsonl --speed 4

Honest by construction: every number on screen comes from the feed named in
the header. Nothing is modeled, delayed-and-relabeled, or made up.

Requires: python-websockets (sudo pacman -S python-websockets)
"""

import argparse
import asyncio
import json
import os
import errno
import shutil
import sys
import termios
import time
import tty
import urllib.request
from collections import defaultdict, deque
from dataclasses import dataclass, field

# ── The Pit ────────────────────────────────────────────────────────────────
AMBER = "\033[38;2;232;163;61m"
UP    = "\033[38;2;70;179;123m"
DOWN  = "\033[38;2;220;80;87m"
TEXT  = "\033[38;2;198;207;223m"
DIM   = "\033[38;2;125;135;152m"
FAINT = "\033[38;2;85;96;112m"
HEAD  = "\033[38;2;237;241;248m"
BOLD  = "\033[1m"
RESET = "\033[0m"
CLEAR = "\033[2J\033[H"
HIDE  = "\033[?25l"
SHOW  = "\033[?25h"

# ── follow the active Omarchy theme ────────────────────────────────────────
# `omarchy-theme-set <anything>` reskins alphad too. ALPHARCH_NO_THEME=1 forces Pit.
def _theme_colors():
    path = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
    if os.environ.get("ALPHARCH_NO_THEME") or not os.path.exists(path):
        return {}
    out = {}
    try:
        for ln in open(path):
            ln = ln.split("#", 1)[0] if not ln.strip().startswith("#") else ""
            if "=" in ln:
                k, v = ln.split("=", 1)
                v = v.strip().strip('"')
                if v.startswith("#") and len(v) == 7:
                    out[k.strip()] = tuple(int(v[i:i + 2], 16) for i in (1, 3, 5))
    except OSError:
        return {}
    return out


def _fg(rgb):
    return "\033[38;2;%d;%d;%dm" % rgb


_tc = _theme_colors()
if _tc:
    AMBER = _fg(_tc.get("accent", (232, 163, 61)))
    UP    = _fg(_tc.get("green", (70, 179, 123)))
    DOWN  = _fg(_tc.get("red", (220, 80, 87)))
    TEXT  = _fg(_tc.get("foreground", (198, 207, 223)))
    DIM   = _fg(_tc.get("dark_foreground", _tc.get("muted", (125, 135, 152))))
    FAINT = _fg(_tc.get("muted", (85, 96, 112)))
    HEAD  = _fg(_tc.get("bright_foreground", _tc.get("foreground", (237, 241, 248))))

# accent intensity ramp for the heatmap (theme bg → accent → near-white)
def _lerp(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))

_BG = _tc.get("background", (10, 13, 20))
_AM = _tc.get("accent", (232, 163, 61))
_HOT = _lerp(_AM, (245, 242, 235), 0.75)
HEAT_RAMP = (
    [f"\033[38;2;{r};{g};{b}m" for r, g, b in (_lerp(_BG, _AM, t) for t in (0.18, 0.36, 0.55, 0.75, 1.0))]
    + [f"\033[38;2;{r};{g};{b}m" for r, g, b in (_lerp(_AM, _HOT, t) for t in (0.5, 1.0))]
)
HEAT_CH = "░▒▓█████"


def fnum(x, dp=2):
    if x >= 1_000_000:
        return f"{x/1e6:.{dp}f}M"
    if x >= 1_000:
        return f"{x/1e3:.{dp}f}K"
    return f"{x:.{dp}f}"


def fpx(p):
    return f"{p:,.2f}" if p < 10000 else f"{p:,.0f}"


def clock(ts=None):
    return time.strftime("%H:%M:%S", time.localtime(ts or time.time()))


# ── data ───────────────────────────────────────────────────────────────────
@dataclass
class Trade:
    ts: float
    price: float
    size: float
    aggressor: str  # "buy" | "sell": the side that crossed the spread


@dataclass
class Liq:
    ts: float
    side: str       # "long" | "short": which position got liquidated
    price: float
    qty: float


@dataclass
class Bucket:
    start: float
    bid_vol: dict = field(default_factory=lambda: defaultdict(float))  # sell aggressors
    ask_vol: dict = field(default_factory=lambda: defaultdict(float))  # buy aggressors
    open_px: float = 0.0
    high: float = 0.0
    low: float = float("inf")
    close: float = 0.0
    trades: int = 0

    @property
    def delta(self):
        return sum(self.ask_vol.values()) - sum(self.bid_vol.values())

    @property
    def volume(self):
        return sum(self.ask_vol.values()) + sum(self.bid_vol.values())

    def poc(self):
        tot = defaultdict(float)
        for p, v in self.ask_vol.items():
            tot[p] += v
        for p, v in self.bid_vol.items():
            tot[p] += v
        return max(tot, key=tot.get) if tot else None


class Engine:
    """All market state. Feeds push events in; views read it out."""

    def __init__(self, tick, bucket_secs, large_mult, imb_ratio):
        self.tick = tick
        self.bucket_secs = bucket_secs
        self.bar_mode = "time"                       # time | range
        self.bar_range = 0.0                         # $ range per bar when bar_mode=range
        self.large_mult = large_mult
        self.imb_ratio = imb_ratio

        self.last = 0.0
        self.session_open = None
        self.session_high = 0.0
        self.session_low = float("inf")
        self.n_trades = 0
        self.started = time.time()

        self.buckets = deque(maxlen=48)
        self.cur = None

        self.tape = deque(maxlen=400)
        self.big_prints = deque(maxlen=40)
        self.sizes = deque(maxlen=600)
        self.rate_win = deque(maxlen=2000)          # trade timestamps

        self.cvd = 0.0
        self.cvd_series = deque(maxlen=600)         # (ts, cvd, price)
        self._pv = 0.0                               # Σ price·size (session)
        self._v = 0.0                                # Σ size
        self.vwap_series = deque(maxlen=600)         # (ts, vwap)

        self.profile = defaultdict(lambda: [0.0, 0.0])  # grid px -> [buy, sell]

        # book
        self.bids = {}
        self.asks = {}
        self.book_ok = False
        self.book_note = ""
        self.heat = deque(maxlen=600)               # (ts, mid, {gridpx: qty}, last, aggr, big)
        self._heat_last = 0.0

        # perp extras
        self.liqs = deque(maxlen=200)
        self.liq_long = 0.0
        self.liq_short = 0.0
        self.funding = None                          # (rate, next_ts)
        self.funding_hours = None                    # funding interval, hours
        self.oi = None                               # (value, ts)
        self.oi_open = None
        self.liq_note = ""                           # why this feed shows no liqs

        self.notes = deque(maxlen=6)                # absorption/divergence flags
        self.event_ts = None                        # feed time (replay-aware)
        self.symbol = ""                             # set by main for friendly screens

    # ── ingest ────────────────────────────────────────────────────────────
    def grid(self, p):
        return round(p / self.tick) * self.tick

    def on_trade(self, t: Trade):
        self.event_ts = t.ts
        self.n_trades += 1
        self.last = t.price
        if self.session_open is None:
            self.session_open = t.price
        self.session_high = max(self.session_high, t.price)
        self.session_low = min(self.session_low, t.price)

        self.tape.append(t)
        self.sizes.append(t.size)
        self.rate_win.append(t.ts)

        signed = t.size if t.aggressor == "buy" else -t.size
        self.cvd += signed
        self.cvd_series.append((t.ts, self.cvd, t.price))
        self._pv += t.price * t.size
        self._v += t.size
        self.vwap_series.append((t.ts, self._pv / self._v))

        g = self.grid(t.price)
        self.profile[g][0 if t.aggressor == "buy" else 1] += t.size

        roll = False
        if self.cur is None:
            roll = True
        elif self.bar_mode == "range" and self.bar_range > 0:
            hi = max(self.cur.high, t.price)
            lo = min(self.cur.low, t.price)
            roll = (hi - lo) >= self.bar_range
        else:
            roll = t.ts - self.cur.start >= self.bucket_secs
        if roll:
            self._close_bucket()
            start = t.ts if self.bar_mode == "range" else t.ts - (t.ts % self.bucket_secs)
            self.cur = Bucket(start=start, open_px=t.price)
        b = self.cur
        b.close = t.price
        b.high = max(b.high, t.price)
        b.low = min(b.low, t.price)
        b.trades += 1
        (b.ask_vol if t.aggressor == "buy" else b.bid_vol)[g] += t.size

        if self.is_big(t.size):
            self.big_prints.append(t)

    def is_big(self, size):
        if len(self.sizes) < 40:
            return False
        mean = sum(self.sizes) / len(self.sizes)
        return size >= self.large_mult * mean

    def _close_bucket(self):
        if self.cur is None:
            return
        b = self.cur
        self.buckets.append(b)
        # absorption: heavy volume, tight range
        if len(self.buckets) >= 6:
            vols = [x.volume for x in list(self.buckets)[-6:-1]]
            rngs = [x.high - x.low for x in list(self.buckets)[-6:-1] if x.high >= x.low]
            if vols and rngs:
                if b.volume > 1.8 * (sum(vols) / len(vols)) and (b.high - b.low) < 0.6 * (sum(rngs) / len(rngs)):
                    side = "bid" if b.delta < 0 else "ask"
                    self.notes.append((b.start, f"absorption at {fpx(b.close)} — heavy volume, no travel ({side} absorbing)"))
        # cvd divergence: price high, cvd not
        if len(self.buckets) >= 8:
            xs = list(self.buckets)[-8:]
            px_hi = max(x.high for x in xs)
            if b.high >= px_hi and b.delta < 0:
                self.notes.append((b.start, f"divergence — new high {fpx(b.high)} on negative delta"))

    def on_book(self, bids, asks, replace=True):
        if replace:
            self.bids = dict(bids)
            self.asks = dict(asks)
        else:
            for p, q in bids:
                if q <= 0:
                    self.bids.pop(p, None)
                else:
                    self.bids[p] = q
            for p, q in asks:
                if q <= 0:
                    self.asks.pop(p, None)
                else:
                    self.asks[p] = q
        self.book_ok = bool(self.bids) and bool(self.asks)
        now = self.event_ts or time.time()
        if self.book_ok and now - self._heat_last >= 1.0:
            self._heat_last = now
            col = defaultdict(float)
            for p, q in list(self.bids.items()) + list(self.asks.items()):
                col[self.grid(p)] += q
            lastt = self.tape[-1] if self.tape else None
            self.heat.append((
                now, self.mid(), dict(col),
                lastt.price if lastt else self.last,
                lastt.aggressor if lastt else "",
                bool(lastt and self.is_big(lastt.size)),
                lastt.size if lastt else 0.0,
            ))

    def mid(self):
        if self.bids and self.asks:
            return (max(self.bids) + min(self.asks)) / 2
        return self.last

    def on_liq(self, lq: Liq):
        self.liqs.append(lq)
        if lq.side == "long":
            self.liq_long += lq.qty
        else:
            self.liq_short += lq.qty

    def rate(self, secs=10):
        cut = time.time() - secs
        return sum(1 for ts in self.rate_win if ts >= cut) / secs

    def delta_last(self, secs):
        cut = time.time() - secs
        d = 0.0
        for t in self.tape:
            if t.ts >= cut:
                d += t.size if t.aggressor == "buy" else -t.size
        return d

    def value_area(self):
        """POC + 70% value area from the session profile."""
        if not self.profile:
            return None, None, None
        tot = {p: b + s for p, (b, s) in self.profile.items()}
        poc = max(tot, key=tot.get)
        target = 0.70 * sum(tot.values())
        got = tot[poc]
        lo = hi = poc
        prices = sorted(tot)
        i, j = prices.index(poc), prices.index(poc)
        while got < target and (i > 0 or j < len(prices) - 1):
            up_v = tot[prices[j + 1]] if j < len(prices) - 1 else -1
            dn_v = tot[prices[i - 1]] if i > 0 else -1
            if up_v >= dn_v:
                j += 1
                hi = prices[j]
                got += up_v
            else:
                i -= 1
                lo = prices[i]
                got += dn_v
        return poc, lo, hi


# ── view helpers ───────────────────────────────────────────────────────────
def header(eng, feedname, symbol, viewname, w):
    chg = ""
    if eng.session_open:
        pct = (eng.last - eng.session_open) / eng.session_open * 100
        col = UP if pct >= 0 else DOWN
        chg = f"{col}{pct:+.2f}%{RESET}"
    left = (f"{BOLD}{HEAD}{symbol}{RESET}  {AMBER}{fpx(eng.last) if eng.last else '—'}{RESET}  {chg}"
            f"  {DIM}H {fpx(eng.session_high) if eng.session_high else '—'} · L {fpx(eng.session_low) if eng.session_low < 1e18 else '—'}{RESET}")
    right = f"{DIM}{feedname} · {viewname} · {clock()}{RESET}"
    pad = max(1, w - visible_len(left) - visible_len(right))
    return left + " " * pad + right


def footer(w, extra=""):
    keys = (f"{DIM}f{FAINT}low  {DIM}d{FAINT}om  {DIM}h{FAINT}eat  {DIM}t{FAINT}ape  "
            f"{DIM}p{FAINT}rofile  {DIM}l{FAINT}iqs  {DIM}+/-{FAINT} tick  {DIM}?{FAINT} help  {DIM}q{FAINT}uit{RESET}")
    line = keys + ("   " + extra if extra else "")
    return f"{FAINT}{'─' * w}{RESET}\n" + line


def visible_len(s):
    out, i, n = 0, 0, len(s)
    while i < n:
        if s[i] == "\033":
            while i < n and s[i] != "m":
                i += 1
            i += 1
        else:
            out += 1
            i += 1
    return out


def bar(v, vmax, width, ch="█"):
    if vmax <= 0:
        return ""
    n = int(round(width * min(v, vmax) / vmax))
    return ch * n


# ── views ──────────────────────────────────────────────────────────────────
def render_flow(eng, w, h):
    """Footprint: rows = price grid, cols = time buckets, bid×ask per cell."""
    out = []
    buckets = list(eng.buckets)[-max(1, (w - 12) // 14):] + ([eng.cur] if eng.cur else [])
    if not buckets:
        sym = f" on {AMBER}{eng.symbol}{DIM}" if eng.symbol else ""
        return (f"\n  {TEXT}connected{DIM} — waiting for the first trades{sym}…{RESET}\n"
                f"  {FAINT}the footprint builds as the market prints · try {DIM}t{FAINT} for the live tape meanwhile{RESET}")
    prices = set()
    for b in buckets:
        prices |= set(b.ask_vol) | set(b.bid_vol)
    if not prices:
        sym = f" on {AMBER}{eng.symbol}{DIM}" if eng.symbol else ""
        return (f"\n  {TEXT}connected{DIM} — waiting for the first trades{sym}…{RESET}\n"
                f"  {FAINT}the footprint builds as the market prints · try {DIM}t{FAINT} for the live tape meanwhile{RESET}")
    prices = sorted(prices, reverse=True)
    maxrows = h - 9
    if len(prices) > maxrows:
        mid = eng.grid(eng.last)
        prices = [p for p in prices if abs(p - mid) <= (maxrows // 2) * eng.tick]
    hdr = " " * 11 + "".join(f"{DIM}{time.strftime('%H:%M', time.localtime(b.start)):>14}{RESET}" for b in buckets)
    out.append(hdr)
    for p in prices:
        row = f"{FAINT}{fpx(p):>10}{RESET} "
        for b in buckets:
            bv, av = b.bid_vol.get(p, 0.0), b.ask_vol.get(p, 0.0)
            if bv == 0 and av == 0:
                row += " " * 14
                continue
            # imbalance tint (diagonal-ish: per-level ratio in v-terminal)
            bcol = DOWN if bv >= eng.imb_ratio * max(av, 0.001) else TEXT
            acol = UP if av >= eng.imb_ratio * max(bv, 0.001) else TEXT
            poc_mark = AMBER + "▏" + RESET if b.poc() == p else " "
            row += f"{poc_mark}{bcol}{fnum(bv,1):>5}{RESET}{FAINT}×{RESET}{acol}{fnum(av,1):<5}{RESET}  "
        out.append(row)
    # delta / volume strip
    drow = f"{DIM}{'Δ':>10}{RESET} "
    vrow = f"{DIM}{'vol':>10}{RESET} "
    for b in buckets:
        col = UP if b.delta >= 0 else DOWN
        drow += f" {col}{fnum(abs(b.delta),1):>12}{RESET} "
        vrow += f" {FAINT}{fnum(b.volume,1):>12}{RESET} "
    out.append(f"{FAINT}{'─' * min(w, 11 + 14 * len(buckets))}{RESET}")
    out.append(drow)
    out.append(vrow)
    cvd_col = UP if eng.cvd >= 0 else DOWN
    out.append(f"{DIM}CVD {cvd_col}{fnum(abs(eng.cvd),1)}{RESET}{DIM} · 1m Δ {fnum(eng.delta_last(60),1)} · rate {eng.rate():.1f}/s{RESET}")
    for ts, note in list(eng.notes)[-2:]:
        out.append(f"{AMBER}◆ {clock(ts)} {note}{RESET}")
    return "\n".join(out)


def render_dom(eng, w, h):
    """Ladder: asks above, bids below, walls flagged, session profile shadow."""
    if not eng.book_ok:
        msg = eng.book_note or "no book on this feed — DOM needs --exchange hyperliquid or binance"
        return f"{DIM}{msg}{RESET}"
    depth = min(((h - 8) // 2), 16)
    asks = sorted(eng.asks.items())[:depth]
    bids = sorted(eng.bids.items(), reverse=True)[:depth]
    allq = [q for _, q in asks + bids]
    qmax = max(allq) if allq else 1
    med = sorted(allq)[len(allq) // 2] if allq else 0
    prof_max = max((b + s for b, s in eng.profile.values()), default=0)
    barw = max(10, (w - 46) // 2)
    out = []
    lastt = eng.tape[-1] if eng.tape else None

    def prof_bar(p):
        b_, s_ = eng.profile.get(eng.grid(p), (0.0, 0.0))
        n = int(round(12 * min(b_ + s_, prof_max) / prof_max)) if prof_max else 0
        return f"{FAINT}{'▍' * n}{RESET}" + " " * (12 - n)

    def ladder_row(p, q, aggr_side, mark_glyph, mark_col):
        wall = f"{AMBER}⚑{RESET}" if med and q > 3 * med else " "
        mark = f"{mark_col}{mark_glyph}{RESET}" if lastt and lastt.aggressor == aggr_side and abs(lastt.price - p) < eng.tick / 2 else " "
        return (f"  {prof_bar(p)}  {TEXT}{fpx(p):>10}{RESET} {DIM}{fnum(q,1):>8}{RESET} "
                f"{FAINT}{bar(q, qmax, barw)}{RESET} {wall}{mark}")

    for p, q in reversed(asks):
        out.append(ladder_row(p, q, "sell", "◀", DOWN))
    spread = (min(eng.asks) - max(eng.bids)) if eng.book_ok else 0
    out.append(f"  {' ' * 12}  {AMBER}{'─' * 10}{RESET} {DIM}spread {spread:.2f}{RESET}")
    for p, q in bids:
        out.append(ladder_row(p, q, "buy", "▶", UP))
    bidsum = sum(q for _, q in bids)
    asksum = sum(q for _, q in asks)
    tot = bidsum + asksum or 1
    out.append("")
    out.append(f"  {DIM}book pressure{RESET}  {UP}{bar(bidsum, tot, 20, '■')}{RESET}{DOWN}{bar(asksum, tot, 20, '■')}{RESET}  {DIM}{bidsum/tot*100:.0f}% bid{RESET}")
    cvd_col = UP if eng.cvd >= 0 else DOWN
    out.append(f"  {DIM}CVD {cvd_col}{fnum(abs(eng.cvd),1)}{RESET}{DIM} · Δ1m {fnum(eng.delta_last(60),1)} · {eng.rate():.1f} trades/s · ⚑ = wall (>3× median){RESET}")
    return "\n".join(out)


def render_heat(eng, w, h):
    """The book through time. Structure stays visible; true walls burn white-hot.
    Prints ride the path as volume-graded bubbles: · ● and ▲▼ for size."""
    if not eng.heat:
        msg = eng.book_note or "no book on this feed — heat needs --exchange hyperliquid or binance"
        return f"{DIM}{msg}{RESET}"
    cols = list(eng.heat)[-(w - 12):]
    rows = h - 7
    center = cols[-1][1]
    top = eng.grid(center) + (rows // 2) * eng.tick
    # percentile reference: one monster wall must not dim the whole book
    allq = sorted(q for c in cols for q in c[2].values() if q > 0)
    if not allq:
        return f"{DIM}book warming up…{RESET}"
    qref = allq[int(len(allq) * 0.90)] or 1
    mean_sz = (sum(eng.sizes) / len(eng.sizes)) if eng.sizes else 0
    n_body = len(HEAT_RAMP) - 2                     # body of the ramp
    out = []
    for r in range(rows):
        p = top - r * eng.tick
        line = f"{FAINT}{fpx(p):>10}{RESET} "
        for (ts, mid, col, lastp, aggr, big, sz) in cols:
            q = col.get(p, 0.0)
            if abs(lastp - p) < eng.tick / 2:
                pc = UP if aggr == "buy" else DOWN if aggr == "sell" else HEAD
                if big:
                    line += pc + ("▲" if aggr == "buy" else "▼") + RESET
                elif mean_sz and sz >= 2 * mean_sz:
                    line += pc + "●" + RESET
                else:
                    line += pc + "·" + RESET
            elif q > 0:
                if q >= 3 * qref:                   # a true wall: white-hot streak
                    i = len(HEAT_RAMP) - 1
                else:
                    i = min(n_body - 1, int(n_body * min(q / qref, 1.0) ** 0.6))
                line += HEAT_RAMP[i] + HEAT_CH[i] + RESET
            else:
                line += " "
        out.append(line)
    out.append(f"{DIM}{'':>10} liquidity fades with size · white-hot = wall (3×) · "
               f"{UP}·{RESET}{DIM}{UP}●{RESET}{DIM}{UP}▲{RESET}{DIM}/{DOWN}▼{RESET}{DIM} prints by volume · 1 col/s{RESET}")
    return "\n".join(out)


def render_tape(eng, w, h):
    out = []
    r = eng.rate()
    heat = min(1.0, r / 20)
    out.append(f"  {DIM}speed{RESET} {AMBER}{bar(heat, 1.0, 30, '■')}{RESET}{FAINT}{'□' * (30 - int(30*heat))}{RESET} {DIM}{r:.1f}/s{RESET}"
               f"   {DIM}CVD{RESET} {(UP if eng.cvd >= 0 else DOWN)}{fnum(abs(eng.cvd),1)}{RESET}"
               f"   {DIM}Δ1m{RESET} {(UP if eng.delta_last(60) >= 0 else DOWN)}{fnum(abs(eng.delta_last(60)),1)}{RESET}")
    out.append("")
    n = h - 8
    trades = list(eng.tape)[-n:]
    smax = max((t.size for t in trades), default=1)
    for t in reversed(trades):
        col = UP if t.aggressor == "buy" else DOWN
        big = f"{AMBER}◆{RESET}" if eng.is_big(t.size) else " "
        out.append(f"  {FAINT}{clock(t.ts)}{RESET}  {col}{fpx(t.price):>10}{RESET}  {TEXT}{fnum(t.size,3):>9}{RESET} {col}{bar(t.size, smax, max(10, w - 50))}{RESET} {big}")
    return "\n".join(out)


def render_profile(eng, w, h):
    if not eng.profile:
        return f"{DIM}building the session profile…{RESET}"
    poc, val, vah = eng.value_area()
    tot = {p: b + s for p, (b, s) in eng.profile.items()}
    prices = sorted(tot, reverse=True)
    maxrows = h - 8
    if len(prices) > maxrows:
        mid = eng.grid(eng.last)
        prices = [p for p in prices if abs(p - mid) <= (maxrows // 2) * eng.tick]
    vmax = max(tot.values())
    barw = max(12, w - 48)
    out = [f"  {DIM}session profile · POC {AMBER}{fpx(poc)}{RESET}{DIM} · value area {fpx(val)} – {fpx(vah)}{RESET}", ""]
    for p in prices:
        b_, s_ = eng.profile[p]
        d = b_ - s_
        dcol = UP if d >= 0 else DOWN
        tag = f"{AMBER}◀ POC{RESET}" if p == poc else (f"{DIM}◁ VA{RESET}" if p in (val, vah) else "")
        inva = val is not None and val <= p <= vah
        bcol = TEXT if inva else FAINT
        cur = f"{HEAD}●{RESET}" if abs(p - eng.grid(eng.last)) < eng.tick / 2 else " "
        out.append(f" {cur}{FAINT}{fpx(p):>10}{RESET} {bcol}{bar(b_ + s_, vmax, barw)}{RESET} {DIM}{fnum(b_ + s_,1):>7}{RESET} {dcol}{'+' if d>=0 else '−'}{fnum(abs(d),1):<7}{RESET} {tag}")
    return "\n".join(out)


def render_liqs(eng, w, h):
    out = []
    if eng.funding:
        rate, nxt = eng.funding
        left = max(0, nxt - time.time())
        hh, mm = int(left // 3600), int(left % 3600 // 60)
        rcol = UP if rate >= 0 else DOWN
        # Never print a bare rate: hyperliquid settles hourly, binance every 8h,
        # and the same number means very different things at the two intervals.
        per = f"/{eng.funding_hours}h" if eng.funding_hours else ""
        out.append(f"  {DIM}funding{per}{RESET} {rcol}{rate*100:+.4f}%{RESET} {DIM}· next in {hh:02d}:{mm:02d}{RESET}"
                   + (f"   {DIM}OI{RESET} {TEXT}{fnum(eng.oi[0],1)}{RESET}"
                      + (f" {DIM}({'+' if eng.oi[0]-eng.oi_open>=0 else ''}{fnum(eng.oi[0]-eng.oi_open,1)} since open){RESET}" if eng.oi_open else "")
                      if eng.oi else ""))
    else:
        out.append(f"  {DIM}funding, open interest and perp depth live on hyperliquid:  alphad --exchange hyperliquid{RESET}")
    tot = eng.liq_long + eng.liq_short
    if tot > 0:
        out.append(f"  {DIM}liquidated{RESET}  {DOWN}longs {fnum(eng.liq_long,1)}{RESET} {DOWN}{bar(eng.liq_long, tot, 18, '■')}{RESET}"
                   f"{UP}{bar(eng.liq_short, tot, 18, '■')}{RESET} {UP}shorts {fnum(eng.liq_short,1)}{RESET}")
    out.append("")
    n = h - 9
    for lq in reversed(list(eng.liqs)[-n:]):
        col = DOWN if lq.side == "long" else UP
        out.append(f"  {FAINT}{clock(lq.ts)}{RESET}  {col}{lq.side.upper():>5} LIQ{RESET}  {TEXT}{fpx(lq.price):>10}{RESET}  {col}{fnum(lq.qty,3)}{RESET}")
    if not eng.liqs:
        # A feed with no public liquidation stream must say so, not just look quiet.
        out.append(f"  {DIM}{eng.liq_note}{RESET}" if eng.liq_note
                   else f"  {DIM}no liquidations yet — quiet tape is information too{RESET}")
    return "\n".join(out)


VIEWS = {
    "flow": render_flow, "dom": render_dom, "heat": render_heat,
    "tape": render_tape, "profile": render_profile, "liqs": render_liqs,
}
KEYMAP = {"f": "flow", "d": "dom", "h": "heat", "t": "tape", "p": "profile", "l": "liqs"}


def render_help(eng, w, h):
    """The ? overlay: everything you can press, right here."""
    rows = [
        ("f", "flow", "footprint — volume at price, delta, imbalances"),
        ("d", "dom", "depth ladder — walls, book pressure"),
        ("h", "heat", "liquidity heatmap — the book through time"),
        ("t", "tape", "time & sales — prints, speed, big-print flags"),
        ("p", "profile", "session volume profile — POC, value area"),
        ("l", "liqs", "liquidations · funding · open interest"),
    ]
    out = ["", f"  {BOLD}{HEAD}THE KEYS{RESET}", ""]
    for k, name, desc in rows:
        out.append(f"    {AMBER}{k}{RESET}  {TEXT}{name:<9}{RESET}{DIM}{desc}{RESET}")
    out.append("")
    out.append(f"    {AMBER}+{RESET} {DIM}/{RESET} {AMBER}-{RESET}  {DIM}coarser / finer price grid{RESET}")
    out.append(f"    {AMBER}?{RESET}      {DIM}close this help{RESET}")
    out.append(f"    {AMBER}q{RESET}      {DIM}quit the window{RESET}")
    out.append("")
    out.append(f"  {FAINT}the whole desk: SUPER+ALT+A opens The Line · alpharch prints the map{RESET}")
    out.append(f"  {FAINT}colors: green/red = direction, only ever direction · amber = attention{RESET}")
    return "\n".join(out)
# live tick-size adjustment: + coarser, - finer (heat/flow/profile grids)


# ── recorder / replay ──────────────────────────────────────────────────────
class Recorder:
    def __init__(self, path, feed="", symbol=""):
        self.f = open(path, "a", buffering=1)
        self._book_last = 0.0
        # Header first: replay needs to know which feed cut the tape, so a
        # hyperliquid tape can repeat "no public liq stream" instead of
        # looking like a market where nothing got liquidated.
        self.f.write(json.dumps({"k": "h", "ts": time.time(),
                                 "feed": feed, "symbol": symbol}) + "\n")

    def trade(self, t: Trade):
        self.f.write(json.dumps({"k": "t", "ts": t.ts, "p": t.price, "s": t.size, "a": t.aggressor}) + "\n")

    def book(self, bids, asks):
        now = time.time()
        if now - self._book_last < 1.0:
            return
        self._book_last = now
        top_b = sorted(bids.items(), reverse=True)[:15]
        top_a = sorted(asks.items())[:15]
        self.f.write(json.dumps({"k": "b", "ts": now, "bids": top_b, "asks": top_a}) + "\n")

    def liq(self, lq: Liq):
        self.f.write(json.dumps({"k": "l", "ts": lq.ts, "side": lq.side, "p": lq.price, "q": lq.qty}) + "\n")

    def funding(self, rate, nxt, hours=None, oi=None):
        self.f.write(json.dumps({"k": "f", "ts": time.time(), "r": rate, "n": nxt,
                                 "h": hours, "oi": oi}) + "\n")


def read_tape_header(path):
    """First line of a tape, if it carries one. Old tapes predate the header
    and simply return None — they replay exactly as they always did."""
    try:
        with open(path) as f:
            first = json.loads(f.readline() or "{}")
        return first if first.get("k") == "h" else None
    except (OSError, ValueError):
        return None


async def replay_feed(eng, rec_path, speed, on_event):
    with open(rec_path) as f:
        lines = [json.loads(x) for x in f if x.strip()]
    if not lines:
        print("empty recording")
        return
    t0 = next((x["ts"] for x in lines if x.get("k") != "h"), lines[0]["ts"])
    wall0 = time.time()
    for ev in lines:
        wait = (ev["ts"] - t0) / speed - (time.time() - wall0)
        if wait > 0:
            await asyncio.sleep(wait)
        eng.event_ts = ev["ts"]
        if ev["k"] == "h":
            if str(ev.get("feed", "")).startswith("hyperliquid"):
                eng.liq_note = HL_NO_LIQ_NOTE
                eng.funding_hours = HL_FUNDING_HOURS
            continue
        if ev["k"] == "t":
            eng.on_trade(Trade(ev["ts"], ev["p"], ev["s"], ev["a"]))
        elif ev["k"] == "b":
            eng.on_book({float(p): q for p, q in ev["bids"]}, {float(p): q for p, q in ev["asks"]})
        elif ev["k"] == "l":
            eng.on_liq(Liq(ev["ts"], ev["side"], ev["p"], ev["q"]))
        elif ev["k"] == "f":
            eng.funding = (ev["r"], ev["n"])
            if ev.get("h"):
                eng.funding_hours = ev["h"]
            if ev.get("oi") is not None:
                eng.oi = (ev["oi"], ev["ts"])
                if eng.oi_open is None:
                    eng.oi_open = ev["oi"]
        on_event()
    eng.notes.append((time.time(), "replay finished"))
    await asyncio.sleep(3600)


# ── deterministic tape analysis ────────────────────────────────────────────
# Pure arithmetic over a recorded tape: no model, no network, no estimation.
# Every number here was computed from events the feed actually delivered, and
# the same tape in always gives the same numbers out. This is the grounding the
# Desk Brain narrates — it reads these facts back and never produces market
# data of its own. Definitions travel WITH the output (see "definitions"), so
# whatever reads it knows exactly what "held" or "wall" was taken to mean.

WALL_MULT = 3.0           # a resting level is a wall at 3x the median level size
WALL_MIN_SNAPSHOTS = 3    # ...and only if it survives three consecutive snapshots
CASCADE_GAP_S = 30.0      # liquidations closer together than this are one cascade
CASCADE_MIN_EVENTS = 3    # ...and it takes three to be called a cascade


def _median(xs):
    s = sorted(xs)
    n = len(s)
    if not n:
        return 0.0
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2


def _clk(ts):
    return time.strftime("%H:%M:%S", time.localtime(ts))


def analyze_tape(path, tick, bucket_secs, large_mult, imb_ratio):
    """Replay a tape through the engine at full speed and return computed facts."""
    try:
        with open(path) as f:
            events = [json.loads(x) for x in f if x.strip()]
    except (OSError, ValueError) as ex:
        return {"error": f"cannot read tape: {ex}"}
    if not events:
        return {"error": "empty tape"}

    eng = Engine(tick, bucket_secs, large_mult, imb_ratio)
    # Analysis wants the whole session, not the rolling windows the live views
    # keep. Unbounded here only; the live engine is untouched.
    eng.notes = deque()
    eng.big_prints = deque()
    eng.buckets = deque()
    eng.cvd_series = deque()

    head = events[0] if events[0].get("k") == "h" else {}
    trades, liqs, funding = [], [], None
    wall_seen = {}                      # (side, price) -> [first_ts, last_ts, n, peak]
    n_book = 0

    for ev in events:
        k, ts = ev.get("k"), ev.get("ts")
        if k == "h" or ts is None:
            continue
        eng.event_ts = ts
        if k == "t":
            t = Trade(ts, ev["p"], ev["s"], ev["a"])
            eng.on_trade(t)
            trades.append(t)
        elif k == "b":
            bids = {float(x): q for x, q in ev["bids"]}
            asks = {float(x): q for x, q in ev["asks"]}
            eng.on_book(bids, asks)
            n_book += 1
            med = _median(list(bids.values()) + list(asks.values()))
            if med > 0:
                for side, book in (("bid", bids), ("ask", asks)):
                    for px, q in book.items():
                        if q >= WALL_MULT * med:
                            w = wall_seen.setdefault((side, px), [ts, ts, 0, 0.0])
                            w[1], w[2], w[3] = ts, w[2] + 1, max(w[3], q)
        elif k == "l":
            lq = Liq(ts, ev["side"], ev["p"], ev["q"])
            eng.on_liq(lq)
            liqs.append(lq)
        elif k == "f":
            funding = {"rate": ev["r"], "next_ts": ev["n"],
                       "interval_hours": ev.get("h"), "open_interest": ev.get("oi")}
    eng._close_bucket()

    if not trades:
        return {"error": "tape has no trades"}

    t_start, t_end = trades[0].ts, trades[-1].ts
    buy_vol = sum(t.size for t in trades if t.aggressor == "buy")
    sell_vol = sum(t.size for t in trades if t.aggressor == "sell")
    mean_size = sum(t.size for t in trades) / len(trades)
    poc, val, vah = eng.value_area()

    # walls: did price go through them, touch them, or never reach them?
    walls = []
    for (side, px), (first, last, n, peak) in wall_seen.items():
        if n < WALL_MIN_SNAPSHOTS:
            continue
        after = [t.price for t in trades if t.ts >= first]
        if not after:
            outcome = "unresolved"
        elif side == "bid":
            lo = min(after)
            outcome = "broke" if lo < px else ("held" if lo <= px + tick else "unresolved")
        else:
            hi = max(after)
            outcome = "broke" if hi > px else ("held" if hi >= px - tick else "unresolved")
        walls.append({"side": side, "price": px, "peak_size": round(peak, 4),
                      "snapshots": n, "first_ts": first, "first_clock": _clk(first),
                      "last_ts": last, "last_clock": _clk(last), "outcome": outcome})
    walls.sort(key=lambda w: -w["peak_size"])

    # liquidation cascades
    cascades, cur = [], None
    for lq in sorted(liqs, key=lambda x: x.ts):
        if cur and lq.ts - cur["end_ts"] <= CASCADE_GAP_S:
            cur["end_ts"] = lq.ts
            cur["events"] += 1
            cur["long_qty" if lq.side == "long" else "short_qty"] += lq.qty
            cur["low"] = min(cur["low"], lq.price)
            cur["high"] = max(cur["high"], lq.price)
        else:
            cur = {"start_ts": lq.ts, "end_ts": lq.ts, "events": 1,
                   "long_qty": lq.qty if lq.side == "long" else 0.0,
                   "short_qty": lq.qty if lq.side == "short" else 0.0,
                   "low": lq.price, "high": lq.price}
            cascades.append(cur)
    for c in cascades:
        c["start_clock"], c["end_clock"] = _clk(c["start_ts"]), _clk(c["end_ts"])
        c["long_qty"], c["short_qty"] = round(c["long_qty"], 4), round(c["short_qty"], 4)
    cascades = [c for c in cascades if c["events"] >= CASCADE_MIN_EVENTS]

    cvd = list(eng.cvd_series)
    step = max(1, -(-len(cvd) // 120))     # ceil: keep the path at 120 points or fewer
    cvd_max = max(cvd, key=lambda c: c[1], default=None)
    cvd_min = min(cvd, key=lambda c: c[1], default=None)
    prof = sorted(eng.profile.items(), key=lambda kv: -(kv[1][0] + kv[1][1]))[:40]

    return {
        "schema": "alpharch.tape-analysis/1",
        "definitions": {
            "wall": f"a resting level at or above {WALL_MULT}x the median level size in "
                    f"the same book snapshot, seen in at least {WALL_MIN_SNAPSHOTS} snapshots",
            "wall_outcome": "broke = price later traded through it; held = price came "
                            "within one tick but never through; unresolved = price never reached it",
            "aggressor": "the side that crossed the spread, as reported by the feed",
            "delta": "buy-aggressor volume minus sell-aggressor volume",
            "value_area": "the 70% volume band around the POC",
            "cascade": f"{CASCADE_MIN_EVENTS}+ liquidations with gaps under {CASCADE_GAP_S}s",
            "big_print": f"a trade at or above {large_mult}x the running mean trade size",
        },
        "tape": {
            "path": os.path.abspath(path),
            "feed": head.get("feed") or "unknown (tape predates the feed header)",
            "symbol": head.get("symbol") or "unknown",
            "start_ts": t_start, "start_clock": _clk(t_start),
            "end_ts": t_end, "end_clock": _clk(t_end),
            "duration_s": round(t_end - t_start, 1),
            "date": time.strftime("%Y-%m-%d", time.localtime(t_start)),
            "counts": {"trades": len(trades), "book_snapshots": n_book,
                       "liquidations": len(liqs)},
            "tick": tick, "bucket_secs": bucket_secs,
        },
        "session": {
            "open": trades[0].price, "close": trades[-1].price,
            "high": eng.session_high, "low": eng.session_low,
            "range": round(eng.session_high - eng.session_low, 6),
            "change_pct": round((trades[-1].price - trades[0].price) / trades[0].price * 100, 4),
        },
        "volume": {
            "total": round(buy_vol + sell_vol, 4), "buy": round(buy_vol, 4),
            "sell": round(sell_vol, 4), "delta": round(buy_vol - sell_vol, 4),
            "mean_trade_size": round(mean_size, 6),
        },
        "profile": {
            "poc": poc, "value_area_low": val, "value_area_high": vah,
            "levels": [{"price": px, "buy": round(b, 4), "sell": round(sv, 4),
                        "total": round(b + sv, 4)} for px, (b, sv) in prof],
        },
        "cvd": {
            "final": round(eng.cvd, 4),
            "max": round(cvd_max[1], 4) if cvd_max else 0.0,
            "max_ts": cvd_max[0] if cvd_max else None,
            "max_clock": _clk(cvd_max[0]) if cvd_max else None,
            "min": round(cvd_min[1], 4) if cvd_min else 0.0,
            "min_ts": cvd_min[0] if cvd_min else None,
            "min_clock": _clk(cvd_min[0]) if cvd_min else None,
            # The path is decimated to stay readable. Whoever reads this must not
            # mistake the largest sampled point for the session extreme — a real
            # number quoted for the wrong claim is still a wrong claim.
            "path_sample_step": step,
            "path_note": (f"decimated: every {step}th point of {len(cvd)}. Use max/min "
                          f"above for the extremes, never the largest point in this path."),
            "path": [{"ts": c[0], "clock": _clk(c[0]), "cvd": round(c[1], 4), "price": c[2]}
                     for c in cvd[::step]],
        },
        "big_prints": [{"ts": t.ts, "clock": _clk(t.ts), "price": t.price,
                        "size": round(t.size, 6), "aggressor": t.aggressor,
                        "x_mean": round(t.size / mean_size, 1) if mean_size else None}
                       for t in sorted(eng.big_prints, key=lambda x: -x.size)[:25]],
        "flags": [{"ts": ts, "clock": _clk(ts), "note": note} for ts, note in eng.notes],
        "walls": walls[:12],
        "liquidations": {
            "long_qty": round(eng.liq_long, 4), "short_qty": round(eng.liq_short, 4),
            "cascades": cascades,
        },
        "funding": funding,
        "buckets": [{"ts": b.start, "clock": _clk(b.start), "open": b.open_px,
                     "high": b.high, "low": b.low if b.low < 1e17 else None,
                     "close": b.close, "volume": round(b.volume, 4),
                     "delta": round(b.delta, 4), "trades": b.trades}
                    for b in list(eng.buckets)[-200:]],
    }


# ── live feeds ─────────────────────────────────────────────────────────────
async def coinbase_feed(eng, symbol, rec, on_event):
    import websockets
    url = "wss://ws-feed.exchange.coinbase.com"
    sub = {"type": "subscribe", "product_ids": [symbol], "channels": ["matches", "level2_batch"]}
    async for ws in websockets.connect(url, ping_interval=20, max_size=2**23):
        try:
            await ws.send(json.dumps(sub))
            async for raw in ws:
                m = json.loads(raw)
                typ = m.get("type")
                if typ in ("match", "last_match"):
                    aggr = "sell" if m["side"] == "buy" else "buy"  # side = maker side
                    t = Trade(time.time(), float(m["price"]), float(m["size"]), aggr)
                    eng.on_trade(t)
                    rec and rec.trade(t)
                    on_event()
                elif typ == "snapshot":
                    eng.on_book({float(p): float(q) for p, q in m.get("bids", [])[:200]},
                                {float(p): float(q) for p, q in m.get("asks", [])[:200]})
                elif typ == "l2update":
                    bids, asks = [], []
                    for side, p, q in m.get("changes", []):
                        (bids if side == "buy" else asks).append((float(p), float(q)))
                    eng.on_book(bids, asks, replace=False)
                    rec and eng.book_ok and rec.book(eng.bids, eng.asks)
                elif typ == "error":
                    eng.book_note = "coinbase book: " + m.get("message", "unavailable") + " — trades still live; use binance for DOM/heat"
        except Exception:
            await asyncio.sleep(2)
            continue


async def binance_feed(eng, symbol, market, rec, on_event):
    import websockets
    s = symbol.lower()
    if market == "perp":
        streams = f"{s}@aggTrade/{s}@depth20@100ms/{s}@forceOrder/{s}@markPrice@1s"
        url = f"wss://fstream.binance.com/stream?streams={streams}"
    else:
        streams = f"{s}@aggTrade/{s}@depth20@100ms"
        url = f"wss://stream.binance.com:9443/stream?streams={streams}"
    async for ws in websockets.connect(url, ping_interval=20, max_size=2**23):
        try:
            async for raw in ws:
                w = json.loads(raw)
                d = w.get("data", w)
                e = d.get("e", "")
                if e == "aggTrade":
                    aggr = "sell" if d["m"] else "buy"
                    t = Trade(d["T"] / 1000, float(d["p"]), float(d["q"]), aggr)
                    eng.on_trade(t)
                    rec and rec.trade(t)
                    on_event()
                elif e == "forceOrder":
                    o = d["o"]
                    side = "long" if o["S"] == "SELL" else "short"
                    lq = Liq(o["T"] / 1000, side, float(o.get("ap") or o["p"]), float(o["q"]))
                    eng.on_liq(lq)
                    rec and rec.liq(lq)
                    on_event()
                elif e == "markPriceUpdate":
                    eng.funding = (float(d["r"]), d["T"] / 1000)
                    rec and rec.funding(*eng.funding)
                elif "bids" in d or "b" in d:
                    bids = d.get("bids", d.get("b", []))
                    asks = d.get("asks", d.get("a", []))
                    eng.on_book({float(p): float(q) for p, q in bids},
                                {float(p): float(q) for p, q in asks})
                    rec and eng.book_ok and rec.book(eng.bids, eng.asks)
        except Exception:
            await asyncio.sleep(2)
            continue


# ── hyperliquid: perps a US desk can actually reach ────────────────────────
# Free, keyless, no accounts. Verified live against the production API:
#   trades          [{coin, side, px, sz, time, hash, tid, users}]  — side is the
#                   AGGRESSOR ("B" lifted the ask, "A" hit the bid), time is ms
#   l2Book          {coin, time, levels: [bids, asks]} — 20 levels a side, and a
#                   FULL snapshot every tick, so the book replaces rather than patches.
#                   Measured 0.23/s. The {"fast": true} variant pushes 1.87/s but
#                   only 5 levels a side; dom and heat exist to show depth, so the
#                   deep book wins and heat simply repeats a column while it waits.
#                   The two are never merged: a composite of two snapshots of
#                   different ages is a book state that never existed.
#   activeAssetCtx  {coin, ctx: {funding, openInterest, markPx, oraclePx, …}} ~1/s
# Keepalive: the websockets protocol ping (ping_interval=20) holds the socket
# open indefinitely; the app-level {"method":"ping"} → {"channel":"pong"} is
# there too but is not needed on top of it.
HL_INFO = "https://api.hyperliquid.xyz/info"
HL_WS = "wss://api.hyperliquid.xyz/ws"

# Hyperliquid funding settles EVERY HOUR, on the hour — confirmed by the API
# itself (info/predictedFundings reports HlPerp fundingIntervalHours: 1, with
# nextFundingTime landing exactly on an hour boundary). Binance is 8h. The same
# printed percentage means eight different things at the two intervals, so the
# interval travels with the rate everywhere it renders.
HL_FUNDING_HOURS = 1

# There is no public per-event liquidation feed. Subscribing to "liquidations"
# or "allLiquidations" is rejected outright ("Error parsing JSON into valid
# websocket request"), and the public tape carries no liquidation marker — over
# thousands of prints the trade objects held exactly the eight fields above.
# Liquidation fills are only exposed per-account, through userFills, which needs
# a wallet address. So the liqs view says this plainly rather than showing an
# empty panel that reads as "nothing is being liquidated".
HL_NO_LIQ_NOTE = ("hyperliquid publishes no public per-event liquidation feed — "
                  "funding, open interest and depth above are live from it")


def hl_coin(symbol):
    """BTC-USD / BTCUSDT / BTC-PERP / btc → BTC. On hyperliquid the coin IS the
    symbol, and it is case-sensitive: a lowercase one drops the connection."""
    s = (symbol or "BTC").upper().strip()
    for suf in ("-PERP", "-USDT", "-USDC", "-USD", "USDT", "USDC", "USD"):
        if s.endswith(suf) and len(s) > len(suf):
            return s[:-len(suf)]
    return s


def hl_universe():
    """Live (non-delisted) perp names. Worth the round trip before subscribing:
    an unknown coin makes the websocket close with no error frame at all, which
    a reconnect loop would otherwise spin on forever behind an empty screen."""
    req = urllib.request.Request(
        HL_INFO, data=json.dumps({"type": "meta"}).encode(),
        headers={"Content-Type": "application/json", "User-Agent": "alpharch"})
    with urllib.request.urlopen(req, timeout=8) as r:
        meta = json.loads(r.read())
    return [a["name"] for a in meta.get("universe", []) if not a.get("isDelisted")]


async def hyperliquid_feed(eng, symbol, rec, on_event):
    import websockets

    coin = hl_coin(symbol)
    loop = asyncio.get_event_loop()
    try:
        universe = await loop.run_in_executor(None, hl_universe)
    except Exception:
        universe = []          # offline: let the socket report the failure
    if universe and coin not in universe:
        # Loud, and in every mode. Subscribing anyway would drop the socket with
        # no error frame, and the reconnect loop would spin behind a blank screen
        # — the exact silent failure this project refuses to ship.
        msg = f"{coin} is not a live hyperliquid perp — try " + ", ".join(universe[:8]) + "…"
        eng.book_note = msg
        eng.notes.append((time.time(), msg))
        raise SystemExit("alphad: " + msg)

    eng.funding_hours = HL_FUNDING_HOURS
    eng.liq_note = HL_NO_LIQ_NOTE
    subs = [{"type": t, "coin": coin} for t in ("trades", "l2Book", "activeAssetCtx")]

    async for ws in websockets.connect(HL_WS, ping_interval=20, max_size=2**23):
        try:
            for sub in subs:
                await ws.send(json.dumps({"method": "subscribe", "subscription": sub}))
            async for raw in ws:
                m = json.loads(raw)
                if not isinstance(m, dict):
                    continue
                ch, d = m.get("channel"), m.get("data")
                if ch == "trades":
                    for x in d:
                        t = Trade(x["time"] / 1000, float(x["px"]), float(x["sz"]),
                                  "buy" if x["side"] == "B" else "sell")
                        eng.on_trade(t)
                        rec and rec.trade(t)
                        on_event()
                elif ch == "l2Book":
                    bids, asks = d["levels"]
                    eng.event_ts = d["time"] / 1000
                    eng.on_book({float(x["px"]): float(x["sz"]) for x in bids},
                                {float(x["px"]): float(x["sz"]) for x in asks})
                    rec and eng.book_ok and rec.book(eng.bids, eng.asks)
                elif ch == "activeAssetCtx":
                    ctx = (d or {}).get("ctx") or {}
                    if ctx.get("funding") is not None:
                        # settles on the hour, so the next mark is the next hour
                        nxt = (int(time.time()) // 3600 + 1) * 3600
                        eng.funding = (float(ctx["funding"]), nxt)
                    if ctx.get("openInterest") is not None:
                        v = float(ctx["openInterest"])
                        eng.oi = (v, time.time())
                        if eng.oi_open is None:
                            eng.oi_open = v
                    if rec and eng.funding:
                        rec.funding(*eng.funding, hours=HL_FUNDING_HOURS,
                                    oi=eng.oi[0] if eng.oi else None)
                elif ch == "error":
                    eng.book_note = "hyperliquid: " + str(d)[:140]
        except Exception:
            await asyncio.sleep(2)
            continue


async def oi_poll(eng, symbol):
    loop = asyncio.get_event_loop()
    url = f"https://fapi.binance.com/fapi/v1/openInterest?symbol={symbol.upper()}"
    while True:
        try:
            data = await loop.run_in_executor(None, lambda: json.loads(
                urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "alpharch"}), timeout=8).read()))
            v = float(data["openInterest"])
            eng.oi = (v, time.time())
            if eng.oi_open is None:
                eng.oi_open = v
        except Exception:
            pass
        await asyncio.sleep(60)


# ── the flow canvas: real pixels, same engine ──────────────────────────────
def canvas_snapshot(eng, args, state=None):
    heat = [{"t": h[0], "mid": h[1], "cols": {str(k): round(v, 3) for k, v in h[2].items()},
             "px": h[3], "aggr": h[4], "big": h[5], "sz": round(h[6], 4)} for h in eng.heat]
    return json.dumps({
        "symbol": args.symbol,
        "feed": args.exchange + (" perp" if args.market == "perp" else ""),
        "last": eng.last, "open": eng.session_open, "high": eng.session_high,
        "low": eng.session_low if eng.session_low < 1e17 else None,
        "tick": eng.tick, "cvd": round(eng.cvd, 3),
        "buckets": [{"t": b.start, "o": b.open_px, "h": b.high, "l": b.low, "c": b.close,
                     "v": round(b.volume, 3), "d": round(b.delta, 3)}
                    for b in list(eng.buckets) + ([eng.cur] if eng.cur else [])],
        "heat": heat,
        "bigs": [{"t": t.ts, "p": t.price, "s": round(t.size, 4), "a": t.aggressor}
                 for t in eng.big_prints],
        "cvds": [{"t": c[0], "v": round(c[1], 3)} for c in eng.cvd_series],
        "vwap": [{"t": c[0], "v": round(c[1], 2)} for c in eng.vwap_series],
        "bars": {"mode": eng.bar_mode, "range": eng.bar_range},
        "indicators": (state or {}).get("indicators", {"vwap": False, "cvd": True}),
        "funding": {"rate": eng.funding[0], "next": eng.funding[1],
                    "hours": eng.funding_hours} if eng.funding else None,
        "oi": eng.oi[0] if eng.oi else None,
    })


def canvas_html_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "..", "share", "canvas.html"),
              os.path.expanduser("~/.local/share/alpharch/share/canvas.html")):
        if os.path.exists(p):
            return p
    return None


async def canvas_server(eng, args, state=None):
    import websockets
    from http import HTTPStatus

    html_path = canvas_html_path()
    if not html_path:
        print("canvas.html not found — reinstall alpharch")
        return
    page = open(html_path, "rb").read()

    def process_request(a, b):
        """Serve canvas.html over plain HTTP; let /ws upgrade to a websocket.
        Handles both websockets APIs: >=13 (connection, request) and legacy
        (path, request_headers)."""
        if hasattr(b, "path"):               # new API: a=connection, b=Request
            p = b.path.split("?")[0]
            if p == "/ws":
                return None
            if p in ("/", "/index.html", "/canvas.html"):
                r = a.respond(HTTPStatus.OK, "")
                r.body = page
                del r.headers["Content-Type"]
                del r.headers["Content-Length"]
                r.headers["Content-Type"] = "text/html; charset=utf-8"
                r.headers["Content-Length"] = str(len(page))
                r.headers["Cache-Control"] = "no-store"
                return r
            return a.respond(HTTPStatus.NOT_FOUND, "404")
        p = a.split("?")[0]                  # legacy API: a=path, b=headers
        if p == "/ws":
            return None
        if p in ("/", "/index.html", "/canvas.html"):
            return (HTTPStatus.OK,
                    [("Content-Type", "text/html; charset=utf-8"),
                     ("Cache-Control", "no-store")], page)
        return (HTTPStatus.NOT_FOUND, [], b"404")

    clients = set()

    async def handler(ws):
        clients.add(ws)
        try:
            await ws.send(canvas_snapshot(eng, args, state))
            async for _ in ws:
                pass
        finally:
            clients.discard(ws)

    async def broadcaster():
        while True:
            if clients:
                msg = canvas_snapshot(eng, args, state)
                await asyncio.gather(*(c.send(msg) for c in list(clients)),
                                     return_exceptions=True)
            await asyncio.sleep(1.0)

    url = f"http://127.0.0.1:{args.port}"

    def open_window():
        """Open a bare app window if a chromium-family browser is around."""
        import shutil as _sh
        for b in ("omarchy-launch-webapp", "chromium", "brave", "google-chrome-stable"):
            if _sh.which(b):
                cmd = f"{b} {url}" if b == "omarchy-launch-webapp" else f"{b} --app={url}"
                os.system(f"setsid {cmd} >/dev/null 2>&1 &")
                return True
        return False

    try:
        server = websockets.serve(handler, "127.0.0.1", args.port,
                                  process_request=process_request, max_size=2**22)
        await server.__aenter__()
    except OSError as ex:
        if ex.errno != errno.EADDRINUSE:
            raise
        # A canvas is already serving this port — this is SUPER+ALT+V pressed
        # twice, not an error. Point a window at the running one and be done.
        print(f"{AMBER}alphad canvas{RESET} already running → {url}")
        open_window()
        # Leave immediately. Other feed tasks are already running under gather(),
        # so a plain return would strand a second, redundant alphad in the
        # background every time the keybinding is pressed again.
        sys.stdout.flush()
        os._exit(0)
    try:
        print(f"{AMBER}alphad canvas{RESET} → {url}   (ctrl-c to stop)")
        open_window()
        await broadcaster()
    finally:
        await server.__aexit__(None, None, None)


# ── the control socket: the Narrator (or any local tool) drives this window ─
# JSON lines over a unix socket in the state dir. Whitelisted keys only; every
# value validated. This is desk control, not code execution.
CTRL_DIR = os.path.expanduser(os.environ.get("ALPHARCH_STATE",
                              "~/.local/state/alpharch")) + "/ctl"


def apply_ctrl(eng, state, msg):
    """Validate and apply one control message. Returns a reply dict."""
    applied = {}
    if "view" in msg:
        v = str(msg["view"])
        if v in VIEWS:
            state["view"] = v; state["help"] = False; applied["view"] = v
    if "tick" in msg:
        try:
            t = float(msg["tick"])
            if 0.0001 <= t <= 100000: eng.tick = t; applied["tick"] = t
        except (TypeError, ValueError): pass
    if "bars" in msg:
        b = msg["bars"]
        if b == "time":
            eng.bar_mode = "time"; applied["bars"] = "time"
        elif isinstance(b, dict) and b.get("mode") == "range":
            try:
                r = float(b.get("range", 0))
                if 0.0001 <= r <= 1000000:
                    eng.bar_mode = "range"; eng.bar_range = r
                    applied["bars"] = {"mode": "range", "range": r}
            except (TypeError, ValueError): pass
    if "indicators" in msg and isinstance(msg["indicators"], dict):
        ind = state.setdefault("indicators", {"vwap": False, "cvd": True})
        for k in ("vwap", "cvd"):
            if k in msg["indicators"]:
                ind[k] = bool(msg["indicators"][k]); applied.setdefault("indicators", {})[k] = ind[k]
    return {"ok": True, "applied": applied,
            "state": {"symbol": eng.symbol, "view": state.get("view"),
                      "tick": eng.tick, "bars": eng.bar_mode,
                      "range": eng.bar_range,
                      "indicators": state.get("indicators", {"vwap": False, "cvd": True})}}


async def ctrl_server(eng, args, state):
    os.makedirs(CTRL_DIR, exist_ok=True)
    path = f"{CTRL_DIR}/{os.getpid()}.sock"
    meta = f"{CTRL_DIR}/{os.getpid()}.json"
    with open(meta, "w") as f:
        json.dump({"pid": os.getpid(), "symbol": args.symbol,
                   "exchange": args.exchange, "canvas": bool(args.canvas),
                   "port": args.port if args.canvas else None}, f)

    async def handle(reader, writer):
        try:
            line = await asyncio.wait_for(reader.readline(), timeout=5)
            msg = json.loads(line.decode())
            reply = apply_ctrl(eng, state, msg) if isinstance(msg, dict) else {"ok": False}
        except Exception as ex:
            reply = {"ok": False, "error": type(ex).__name__}
        try:
            writer.write((json.dumps(reply) + "\n").encode())
            await writer.drain(); writer.close()
        except Exception:
            pass

    server = await asyncio.start_unix_server(handle, path=path)

    def cleanup():
        for p in (path, meta):
            try: os.unlink(p)
            except OSError: pass
    import atexit
    atexit.register(cleanup)
    async with server:
        await asyncio.Event().wait()


# ── ui loop ────────────────────────────────────────────────────────────────
async def ui(eng, args, state):
    feedname = ("replay×" + str(args.speed) + (" · " + args.replay_feed if args.replay_feed else "")) \
        if args.replay else (args.exchange + (" perp" if args.market == "perp" else ""))
    while True:
        w, h = shutil.get_terminal_size()
        view = state["view"]
        try:
            if state.get("help"):
                body = render_help(eng, w, h)
            else:
                body = VIEWS[view](eng, w, h)
        except Exception as ex:
            body = f"{DOWN}render error in {view}: {ex}{RESET}"
        extra = f"{FAINT}{'REC ' + args.record if args.record else ''}{RESET}"
        frame = (header(eng, feedname, args.symbol, view, w) + "\n"
                 + f"{FAINT}{'─' * w}{RESET}\n" + body + "\n" + footer(w, extra))
        sys.stdout.write(CLEAR + frame + "\n")
        sys.stdout.flush()
        await asyncio.sleep(args.refresh)


def setup_keys(state, loop):
    if not sys.stdin.isatty():
        return None
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)

    def on_key():
        ch = os.read(fd, 1).decode(errors="ignore")
        if ch == "q":
            loop.stop()
        elif ch == "?":
            state["help"] = not state.get("help")
        elif ch in KEYMAP:
            state["view"] = KEYMAP[ch]
            state["help"] = False
        elif ch in "+=":
            state["eng"].tick *= 2
        elif ch == "-":
            state["eng"].tick = max(state["eng"].tick / 2, 0.01)

    loop.add_reader(fd, on_key)
    return old


async def main_async(args):
    eng = Engine(args.tick, args.bucket, args.large, args.imbalance)
    eng.symbol = args.symbol
    feedname = args.exchange + (" perp" if args.market == "perp" else "")
    rec = Recorder(args.record, feedname, args.symbol) if args.record else None
    state = {"view": args.view, "eng": eng}

    def on_event():
        pass

    if args.json:
        # raw event stream mode: print every trade as JSON, no UI
        def on_event_json():
            if not eng.tape:
                return
            t = eng.tape[-1]
            print(json.dumps({"ts": t.ts, "price": t.price, "size": t.size, "aggr": t.aggressor, "cvd": eng.cvd}), flush=True)
        tasks = [feed_task(eng, args, rec, on_event_json)]
        await asyncio.gather(*tasks)
        return

    if args.canvas:
        tasks = [feed_task(eng, args, rec, on_event), canvas_server(eng, args, state),
                 ctrl_server(eng, args, state)]
        if args.exchange == "binance" and args.market == "perp" and not args.replay:
            tasks.append(oi_poll(eng, args.symbol))
        await asyncio.gather(*tasks)
        return

    loop = asyncio.get_event_loop()
    old_tty = setup_keys(state, loop)
    try:
        tasks = [feed_task(eng, args, rec, on_event), ui(eng, args, state),
                 ctrl_server(eng, args, state)]
        if args.exchange == "binance" and args.market == "perp" and not args.replay:
            tasks.append(oi_poll(eng, args.symbol))
        await asyncio.gather(*tasks)
    finally:
        if old_tty:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_tty)


def feed_task(eng, args, rec, on_event):
    if args.replay:
        return replay_feed(eng, args.replay, args.speed, on_event)
    if args.exchange == "hyperliquid":
        return hyperliquid_feed(eng, args.symbol, rec, on_event)
    if args.exchange == "binance":
        return binance_feed(eng, args.symbol, args.market, rec, on_event)
    return coinbase_feed(eng, args.symbol, rec, on_event)


def main():
    ap = argparse.ArgumentParser(description="alphad — the Alpharch flow engine")
    ap.add_argument("--exchange", choices=["coinbase", "binance", "hyperliquid"],
                    default="coinbase")
    ap.add_argument("--market", choices=["spot", "perp"], default=None,
                    help="perp adds funding, open interest (and liqs on binance); "
                         "implied by --exchange hyperliquid")
    ap.add_argument("--symbol", default=None,
                    help="BTC-USD (coinbase), BTCUSDT (binance) or BTC (hyperliquid)")
    ap.add_argument("--view", choices=list(VIEWS), default="flow")
    ap.add_argument("--tick", type=float, default=10.0, help="price grid size")
    ap.add_argument("--bucket", type=int, default=60, help="footprint column seconds")
    ap.add_argument("--large", type=float, default=8.0, help="big print = N × mean size")
    ap.add_argument("--imbalance", type=float, default=3.0, help="imbalance ratio")
    ap.add_argument("--refresh", type=float, default=0.5)
    ap.add_argument("--record", metavar="FILE", help="append events to a JSONL tape")
    ap.add_argument("--replay", metavar="FILE", help="replay a recorded tape")
    ap.add_argument("--analyze", metavar="FILE",
                    help="read a recorded tape and print computed facts as JSON "
                         "(pure arithmetic — no model, no network)")
    ap.add_argument("--speed", type=float, default=1.0, help="replay speed multiple")
    ap.add_argument("--json", action="store_true", help="raw trade stream on stdout")
    ap.add_argument("--canvas", action="store_true",
                    help="serve the flow canvas (real-pixel renderer) on localhost")
    ap.add_argument("--port", type=int, default=7860, help="canvas port")
    args = ap.parse_args()

    # A tape knows which instrument and feed it recorded; trust it over the
    # defaults, or a hyperliquid BTC tape replays labelled BTC-USD (coinbase spot).
    args.replay_feed = ""
    head = read_tape_header(args.replay) if args.replay else None  # analyze exits earlier
    if head:
        args.symbol = args.symbol or head.get("symbol") or None
        args.replay_feed = head.get("feed") or ""
    if args.symbol is None:
        args.symbol = {"binance": "BTCUSDT", "hyperliquid": "BTC"}.get(args.exchange, "BTC-USD")
    if args.market is None:
        args.market = "perp" if args.exchange == "hyperliquid" else "spot"
    if args.exchange == "hyperliquid":
        args.symbol = hl_coin(args.symbol)
        if args.market != "perp":
            ap.error("the hyperliquid adapter covers perps — use --exchange coinbase for spot")
    elif args.market == "perp" and args.exchange != "binance":
        ap.error("--market perp requires --exchange hyperliquid (or binance)")

    if args.analyze:
        facts = analyze_tape(args.analyze, args.tick, args.bucket, args.large, args.imbalance)
        print(json.dumps(facts, indent=2))
        sys.exit(1 if "error" in facts else 0)

    if not args.replay:
        import importlib.util
        if importlib.util.find_spec("websockets") is None:
            print("alphad needs python-websockets:  sudo pacman -S python-websockets")
            sys.exit(1)

    sys.stdout.write(HIDE)
    try:
        asyncio.run(main_async(args))
    except (KeyboardInterrupt, RuntimeError):
        pass
    finally:
        sys.stdout.write(SHOW + RESET + "\n")


if __name__ == "__main__":
    main()
