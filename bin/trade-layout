#!/usr/bin/env python3
"""Save and restore named Alpharch engine/Omarchy desk presets. No order enablement."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import socket
import subprocess
import sys
import time

ROOT=Path(__file__).resolve().parents[1]
STATE=Path(os.environ.get('ALPHARCH_STATE',Path.home()/'.local/state/alpharch'))
PRESETS=Path(os.environ.get('ALPHARCH_HOME',Path.home()/'.config/alpharch'))/'layouts'


def request(path,message):
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(2);sock.connect(str(path));sock.sendall((json.dumps(message)+'\n').encode())
        result=b''
        while b'\n' not in result and len(result)<1024*1024:
            part=sock.recv(65536)
            if not part:break
            result+=part
        return json.loads(result)


def hypr(kind):
    try:return json.loads(subprocess.check_output(['hyprctl','-j',kind],timeout=2,stderr=subprocess.DEVNULL))
    except (OSError,ValueError,subprocess.SubprocessError):return []


def capture():
    windows=hypr('clients');monitors={m['id']:m['name'] for m in hypr('monitors')}
    engines=[]
    for path in sorted((STATE/'ctl').glob('*.json')):
        try:
            meta=json.loads(path.read_text())
            if not meta.get('canvas'):continue
            state=request(path.with_suffix('.sock'),{})['state']
            item={k:meta.get(k) for k in ('symbol','exchange','market','port','replay')}
            item.update(tick=state['tick'],bucket=state.get('seconds',60),view=state.get('view','flow'),
                        controls={'bars':{'mode':state['bars'],'range':state['range'],'value':state.get('seconds',60) if state['bars']=='time' else state.get('count',100)},
                                  'technical':state.get('technical',{})},workspace=state.get('workspace',{}))
            client=next((c for c in windows if f"· {item['port']}" in c.get('title','') and c.get('title','').startswith('Alpharch')),None)
            item['desktop']=str(client.get('workspace',{}).get('name','1')) if client else str(len(engines)+1)
            item['monitor']=monitors.get(client.get('monitor')) if client else None
            engines.append(item)
        except (OSError,ValueError,KeyError):continue
    if not engines:raise ValueError('No reachable graphical engines. Open a workspace first.')
    return {'schema':'alpharch.desk/1','saved':time.time(),'engines':engines}


def validate(data):
    if data.get('schema')!='alpharch.desk/1' or not isinstance(data.get('engines'),list) or not 1<=len(data['engines'])<=12:
        raise ValueError('Expected 1–12 engines in an alpharch.desk/1 preset')
    ports=set()
    for item in data['engines']:
        if item.get('exchange') not in ('coinbase','binance','hyperliquid'):raise ValueError('Unsupported exchange')
        if not isinstance(item.get('symbol'),str) or not re.fullmatch(r'[A-Za-z0-9._:/-]{1,80}',item['symbol']):raise ValueError('Invalid symbol')
        port=item.get('port')
        if type(port) is not int or not 1024<=port<=65535 or port in ports:raise ValueError('Ports must be unique and 1024–65535')
        ports.add(port)
        for key in ('tick','bucket'):
            value=item.get(key)
            if not isinstance(value,(int,float)) or not 0<value<=100000:raise ValueError('Invalid '+key)
        if item.get('replay') and not isinstance(item['replay'],str):raise ValueError('Invalid replay path')
        if not isinstance(item.get('desktop','1'),str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,40}',item.get('desktop','1')):raise ValueError('Invalid desktop')
    return data


def restore(data,dry_run=False):
    validate(data)
    monitors=[m['name'] for m in hypr('monitors')]
    for index,item in enumerate(data['engines']):
        args=[str(ROOT/'bin/alphad'),'--canvas','--port',str(item['port']),'--tick',str(item['tick']),'--bucket',str(int(item['bucket']))]
        if item.get('replay'):
            if not Path(item['replay']).expanduser().is_file():
                print('Unavailable replay; skipped:',item['replay']);continue
            args+=['--replay',str(Path(item['replay']).expanduser()),'--start-paused']
        else:
            args+=['--exchange',item['exchange'],'--symbol',item['symbol']]
            if item.get('market') in ('spot','perp'):args+=['--market',item['market']]
        monitor=item.get('monitor')
        if monitors and monitor not in monitors:monitor=monitors[index%len(monitors)]
        print(json.dumps({'launch':args,'desktop':item.get('desktop','1'),'monitor':monitor,'paper':'disabled'}))
        if dry_run:continue
        # Fixed shell program invokes the project's dialect-aware Hyprland helpers.
        if monitors:
            script='source "$1"; [[ -z "$4" ]] || hypr_workspace_to_monitor "$2" "$4"; hypr_exec_on_workspace "$2" "$3"'
            subprocess.run(['bash','-c',script,'trade-layout',str(ROOT/'lib/alpharch-common.sh'),item.get('desktop','1'),shlex.join(args),monitor or ''],check=True)
        else:subprocess.Popen(args,start_new_session=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        # Reconcile against the newly reachable local engine, never an order endpoint.
        for attempt in range(20):
            found=False
            for path in (STATE/'ctl').glob('*.json'):
                try:
                    meta=json.loads(path.read_text())
                    if meta.get('port')!=item['port'] or meta.get('symbol')!=item['symbol']:continue
                    request(path.with_suffix('.sock'),{**item.get('controls',{}),'workspace':item.get('workspace',{}),'restore':True})
                    found=True;break
                except (OSError,ValueError):continue
            if found:break
            time.sleep(.2)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['save','load','list','delete','export','import'])
    parser.add_argument('name',nargs='?');parser.add_argument('file',nargs='?')
    parser.add_argument('--dry-run',action='store_true')
    args=parser.parse_args();PRESETS.mkdir(parents=True,exist_ok=True)
    try:
        if args.action=='list':
            print('\n'.join(p.stem for p in PRESETS.glob('*.json')));return
        if not args.name or not re.fullmatch(r'[A-Za-z0-9_-]{1,60}',args.name):raise ValueError('Use a name with letters, numbers, dash or underscore')
        path=PRESETS/(args.name+'.json')
        if args.action=='save':
            data=capture();tmp=path.with_suffix('.tmp');tmp.write_text(json.dumps(data,indent=2));tmp.replace(path)
        elif args.action=='load':restore(json.loads(path.read_text()),args.dry_run)
        elif args.action=='delete':path.unlink()
        elif args.action=='export':
            if not args.file:raise ValueError('Output file required')
            with open(args.file,'x') as out:json.dump(validate(json.loads(path.read_text())),out,indent=2)
        elif args.action=='import':
            if not args.file:raise ValueError('Input file required')
            if Path(args.file).stat().st_size>1024*1024:raise ValueError('Preset exceeds 1 MB')
            data=validate(json.loads(Path(args.file).read_text()))
            with path.open('x') as out:json.dump(data,out,indent=2)
    except (OSError,ValueError,subprocess.SubprocessError) as exc:parser.exit(1,f'Layout: {exc}\n')

if __name__=='__main__':main()
